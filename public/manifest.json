{
  "manifest_version": 3,
  "name": "VoidTab - Cyberpunk Dashboard",
  "version": "1.0.5",
  "description": "极简、赛博朋克风格的浏览器新标签页，支持搜索、快捷访问与主题自定义，并可进行数据云同步。",
  "short_description": "赛博朋克风新标签页：快捷访问、搜索、主题自定义、云同步。",
  "author": "Fly",
  "homepage_url": "https://github.com/flycodeu",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "favicon"
  ],
  "host_permissions": [
    "https://geocoding-api.open-meteo.com/*",
    "https://api.open-meteo.com/*",
    "https://air-quality-api.open-meteo.com/*",
    "https://api.bigdatacloud.net/*",
    "https://api.github.com/*",
    "https://query1.finance.yahoo.com/*",
    "https://ipwho.is/*",
    "https://ipapi.co/*",
    "https://api.ip.sb/*",
    "https://api.iowen.cn/*",
    "https://www.google.com/*",
    "https://t2.gstatic.com/*",
    "https://icons.duckduckgo.com/*",
    "https://favicon.yandex.net/*",
    "https://favicon.im/*",
    "https://icon.horse/*",
    "https://unavatar.io/*",
    "https://timor.tech/*",
    "https://api.deepseek.com/*",
    "https://api.siliconflow.cn/*",
    "https://api.openai.com/*",
    "https://api.moonshot.cn/*",
    "https://*.jianguoyun.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https:;"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "VoidTab"
  },
  "minimum_edge_version": "114.0.0.0"
}
