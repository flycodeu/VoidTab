{
  "manifest_version": 3,
  "name": "VoidTab - Cyberpunk Dashboard",
  "version": "1.0.1",
  "description": "极简、赛博朋克风格的浏览器新标签页，支持搜索、快捷访问与主题自定义，并可进行数据云同步。",
  "short_description": "赛博朋克风新标签页：快捷访问、搜索、主题自定义、云同步。",
  "author": "Fly",
  "homepage_url": "https://github.com/flycodeu",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://geocoding-api.open-meteo.com/*",
    "https://api.open-meteo.com/*",
    "https://*.jianguoyun.com/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "minimum_edge_version": "114.0.0.0"
}
